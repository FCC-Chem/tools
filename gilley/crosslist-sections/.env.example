# Copy this file to .env (next to script.py) and fill in your values.
# .env is blocked by .gitignore. Never commit it.
#
# Token: Canvas > Account > Settings > Approved Integrations > + New Access Token
# Treat the token like a password — anyone with it has your Canvas access.

CANVAS_URL=https://scccd.instructure.com
CANVAS_API_TOKEN=your-token-here
