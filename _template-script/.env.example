# Copy this file to .env and fill in your values.
# .env is blocked by .gitignore. Never commit it.
#
# Most institutions require an APP PASSWORD, not your normal login
# password, and many block SMTP from off campus. Test before you need it.

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=you@scccd.edu
SMTP_PASS=your-app-password-here
FROM_EMAIL=you@scccd.edu
